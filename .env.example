# ==============================================================================
# VISTA AI Companion — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root:
#   cp .env.example .env
#
# IMPORTANT:
#   Never commit actual API keys or secrets to version control.
#   The '.env' file is explicitly ignored in '.gitignore'.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Network Configuration
# ------------------------------------------------------------------------------
# Port number for the Express companion API server.
# Default: 3001
PORT=3001

# Runtime environment mode: 'development' | 'production' | 'test'
# - development: Enables verbose logging and hot reloading.
# - production: Optimized serving mode.
# - test: Bypasses automatic server port listening for test runners.
# Default: development
NODE_ENV=development

# ------------------------------------------------------------------------------
# AI Provider Integration (Hybrid Multimodal & Semantic Engine)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Optional)
# - When set: Enables cloud-based multimodal frame reasoning and deep narrative analysis.
# - When empty/omitted: VISTA seamlessly falls back to its 100% offline Local Semantic Engine
#   with heuristic luminance/color Ambilight tracking and local keyword reasoning.
# Default: (empty)
GEMINI_API_KEY=

# Google Gemini Model Name (Optional)
# Target Gemini model version for vision and chat reasoning.
# Typical values: 'gemini-1.5-flash' (fast/efficient) or 'gemini-1.5-pro' (high-capability).
# Default: gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Storage & Persistence Configuration
# ------------------------------------------------------------------------------
# Local filesystem directory for persistent database storage (JSON / SQLite).
# Defaults to the repository's server/data directory.
# Default: ./server/data
VISTA_DATA_DIR=./server/data

# ------------------------------------------------------------------------------
# Logging & Diagnostics
# ------------------------------------------------------------------------------
# Logging verbosity level: 'debug' | 'info' | 'warn' | 'error'
# Default: info
LOG_LEVEL=info
