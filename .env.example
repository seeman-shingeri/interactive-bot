# ==========================================
# VISTA Environment Configuration
# ==========================================

# Server Port (Default: 3001)
PORT=3001

# Node Environment ('development' | 'production')
NODE_ENV=development

# Google Gemini API Key (Optional)
# If provided, enables real multimodal vision via Google GenAI SDK.
# If omitted, VISTA seamlessly falls back to its built-in Local Semantic Engine.
GEMINI_API_KEY=

# Local Database Storage Directory
VISTA_DATA_DIR=./server/data

# Logging Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info
