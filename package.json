{
  "name": "vista-ai-companion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node --loader ts-node/esm server/index.ts || tsx server/index.ts || node server/index.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx test_suite.ts",
    "test:unit": "tsx tests/companion_unit_tests.ts",
    "test:e2e": "tsx tests/e2e_companion_flow.ts",
    "test:stress": "tsx tests/stress_test.ts",
    "verify:companion": "tsx scripts/verify_companion.ts",
    "backup:db": "tsx scripts/backup_db.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^6.0.7"
  }
}
